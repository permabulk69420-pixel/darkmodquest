    <string name="vr_fog_label" translatable="false">Fog and mist (slower)</string>
    <string name="vr_renderer_diagnostics_label" translatable="false">Show renderer diagnostics overlay</string>
    <string name="vr_hud_height_label" translatable="false">HUD / menu screen size</string>
    <string name="vr_hud_distance_label" translatable="false">HUD / menu screen distance</string>
    <string name="vr_hud_offset_label" translatable="false">HUD / menu screen height offset</string>
    <string name="vr_settings_hint" translatable="false">Used when the game is started in VR.</string>

    <string-array name="vr_resolution_scale_labels" translatable="false">
        <item>50%</item><item>65%</item><item>75%</item><item>85%</item><item>100%</item><item>120%</item>
    </string-array>
