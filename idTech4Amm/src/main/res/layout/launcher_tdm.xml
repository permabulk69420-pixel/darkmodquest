<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:myapp="http://schemas.android.com/apk/res/com.karin.idTech4Amm"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/layout_border"
    android:layout_marginHorizontal="4dp" android:layout_marginVertical="2dp"
    >

    <com.karin.idTech4Amm.widget.Divider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        myapp:label="@string/tdm_base"
        myapp:lineColor="@color/launcher_divider_color" />

    <CheckBox
        android:id="@+id/tdm_useMediumPrecision"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/use_medium_precision_float_in_glsl_shader_harm_r_usemediumprecision" />


    <com.karin.idTech4Amm.widget.Divider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        myapp:label="@string/vr_settings_title"
        myapp:lineColor="@color/launcher_divider_color" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vr_settings_hint" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vr_resolution_scale_label" />

    <Spinner
        android:id="@+id/vr_resolution_scale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/vr_resolution_scale_labels" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vr_foveation_label" />

    <Spinner
        android:id="@+id/vr_foveation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/vr_foveation_labels" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vr_refresh_rate_label" />

    <Spinner
        android:id="@+id/vr_refresh_rate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/vr_refresh_rate_labels" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vr_hud_height_label" />

    <Spinner
        android:id="@+id/vr_hud_height"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/vr_hud_height_labels" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vr_hud_distance_label" />

    <Spinner
        android:id="@+id/vr_hud_distance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/vr_hud_distance_labels" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/vr_hud_offset_label" />

    <Spinner
        android:id="@+id/vr_hud_offset"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:entries="@array/vr_hud_offset_labels" />

    <CheckBox
        android:id="@+id/vr_fog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vr_fog_label" />

    <CheckBox
        android:id="@+id/vr_renderer_diagnostics"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vr_renderer_diagnostics_label" />

    <CheckBox
        android:id="@+id/vr_show_perf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vr_show_perf_label" />

    <CheckBox
        android:id="@+id/vr_srgb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vr_srgb_label" />

</LinearLayout>
